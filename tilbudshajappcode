function scoreSearch(deal, tokens) {
  if (!tokens.length) return 1;
  const hay = [deal.name, deal.desc||"", deal.store, deal.cat||""].join(" ").toLowerCase().split(/[\s,\-\/]+/);
  let tot = 0;
  for (const t of tokens) {
    const syns = SYNS[t] || [t]; let best = 0;
    for (const s of syns) for (const w of hay) {
      if (w===s) best=Math.max(best,3);
      else if (w.startsWith(s)) best=Math.max(best,2);
      else if (s.length>=3 && w.endsWith(s) && w!==s) best=Math.max(best,1.5);
