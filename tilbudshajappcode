function cheapestStore(meal) {
  const t={};
  for (const i of meal.ingredients) if (i.onSale&&i.store) t[i.store]=(t[i.store]||0)+(i.price||0);
  const e=Object.entries(t);
  return e.length ? e.sort((a,b)=>a[1]-b[1])[0][0] : null;
}
function storeCost(meal,s) {
  return meal.ingredients.filter(i=>i.store===s).reduce((sum,i)=>sum+(i.price||0),0);
}

async function generateMeals() {
  state.mealsLoading=true; state.meals=[]; state.mealSelected=null; state.mealMode=null;
  render();
  const src = state.deals.length>0 ? state.deals : DEMO;
  const summary = src.slice(0,50).map(d=>`${d.name} (${d.store}, ${d.price} kr, ${d.unit||""})`).join("\n");
  try {
    const text = await callAI([{role:"user",content:`Lav 5 billige hverdagsretter baseret på disse tilbud:\n${summary}\n\nSvar KUN med JSON array, ingen backticks:\n[{"title":"Navn","emoji":"🍗","desc":"1 sætning","time":"30 min","portions":4,"totalPrice":65,"ingredients":[{"name":"Kyllingefilet","amount":"400 g","store":"Rema 1000","price":20,"onSale":true},{"name":"Fløde","amount":"2 dl","store":null,"price":9,"onSale":false}],"steps":["Trin 1","Trin 2"]}]`}]);
    state.meals = extractJSON(text);
  } catch { state.meals = FB_MEALS; }
  state.mealsLoading=false;
  render();
}

