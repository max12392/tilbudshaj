let searchTimer = null;
let logoClicks = 0, logoTimer = null;

function bindCustomer() {
  // Logo 5 tryk
  const logoBtn = document.getElementById("logoBtn");
  if (logoBtn) {
    logoBtn.onclick = () => {
      logoClicks++;
      clearTimeout(logoTimer);
      logoTimer = setTimeout(()=>{ logoClicks=0; }, 2000);
      if (logoClicks >= 5) {
        logoClicks = 0; clearTimeout(logoTimer);
        state.page = isAdminLoggedIn() ? "admin" : "admin-login";
        render();
      }
    };
  }

  // Søg
  const si = document.getElementById("searchInput");
  if (si) {
    si.addEventListener("input", e => {
      state.input = e.target.value;
      clearTimeout(searchTimer);
      if (!state.input) { state.search=""; state.suggs=[]; render(); return; }
      searchTimer = setTimeout(()=>{
        state.search = state.input;
        const toks = state.input.toLowerCase().trim().split(/\s+/).filter(t=>t.length>1);
        const seen=new Set(), res=[];
        for (const d of state.deals) {
          if (scoreSearch(d,toks)>0) {
            const lbl=d.name.split(" ").slice(0,3).join(" ");
            if (!seen.has(lbl)) { seen.add(lbl); res.push({label:lbl,store:d.store}); }
            if (res.length>=5) break;
          }
        }
        state.suggs = res;
        render();
      }, 180);
    });
    si.addEventListener("keydown", e => {
      if (e.key==="Escape") { state.input=""; state.search=""; state.suggs=[]; render(); }
    });
    si.addEventListener("focus", () => {
      if (state.input.length>=2 && !state.suggs.length) {
        const ev = new Event("input"); si.dispatchEvent(ev);
      }
    });
    si.addEventListener("blur", ()=>{ setTimeout(()=>{ state.suggs=[]; render(); }, 150); });
  }

  const sc = document.getElementById("searchClear");
  if (sc) sc.onclick = ()=>{ state.input=""; state.search=""; state.suggs=[]; render(); };

  // Forslag
  document.querySelectorAll(".sugg-item").forEach(el => {
    el.onmousedown = ()=>{
      state.input = el.dataset.label;
      state.search = el.dataset.label;
      state.suggs = [];
      render();
    };
  });

  // Butik pills
  document.querySelectorAll("[data-store]").forEach(el=>{
    el.onclick = ()=>{ state.store=el.dataset.store; render(); };
  });

  // Kat pills
  document.querySelectorAll("[data-cat]").forEach(el=>{
    el.onclick = ()=>{ state.cat=el.dataset.cat; render(); };
  });

  // Sort
  const ss = document.getElementById("sortSelect");
  if (ss) ss.onchange = e=>{ state.sort=e.target.value; render(); };

  // Qty buttons
  document.querySelectorAll("[data-delta]").forEach(btn=>{
    btn.onclick = ()=>{ cartUpdate(btn.dataset.id, parseInt(btn.dataset.delta)); };
  });

  // Cart
  const cartBtn = document.getElementById("cartBtn");
  if (cartBtn) cartBtn.onclick = ()=>{ state.cartOpen=true; render(); };

  const cartOverlay = document.getElementById("cartOverlay");
  if (cartOverlay) cartOverlay.onclick = ()=>{ state.cartOpen=false; render(); };

  const cartClose = document.getElementById("cartClose");
  if (cartClose) cartClose.onclick = ()=>{ state.cartOpen=false; render(); };

  const cartClear = document.getElementById("cartClear");
  if (cartClear) cartClear.onclick = ()=>{ state.cart=[]; render(); };

  document.querySelectorAll("[data-cart-id]").forEach(btn=>{
    btn.onclick = ()=>{ cartUpdate(btn.dataset.cartId, parseInt(btn.dataset.cartDelta)); };
  });

  document.querySelectorAll("[data-cart-remove]").forEach(btn=>{
    btn.onclick = ()=>{ state.cart=state.cart.filter(d=>d.id!==btn.dataset.cartRemove); render(); };
  });

  // Meal btn
  const mealBtn = document.getElementById("mealBtn");
  if (mealBtn) mealBtn.onclick = ()=>{ state.page="meals"; render(); };

  // Ad banner drag
  bindAdBanner();
}

function cartUpdate(id, delta) {
  const ex = state.cart.find(d=>d.id===id);
  if (!ex) {
    if (delta>0) {
      const deal = state.deals.find(d=>d.id===id);
      if (deal) state.cart.push({...deal, qty:1});
    }
  } else {
    const q = ex.qty + delta;
    if (q<=0) state.cart = state.cart.filter(d=>d.id!==id);
    else state.cart = state.cart.map(d=>d.id===id ? {...d,qty:q} : d);
  }
  render();
}

function bindAdBanner() {
  const el = document.getElementById("adScroll");
  if (!el) return;
  let drag = false, sx=0, sl=0;
  el.onmousedown = e=>{ drag=true; sx=e.clientX; sl=el.scrollLeft; };
  el.onmousemove = e=>{ if(drag) el.scrollLeft=sl-(e.clientX-sx); };
  el.onmouseup = ()=>{ drag=false; };
  el.onmouseleave = ()=>{ drag=false; };
  el.ontouchstart = e=>{ sx=e.touches[0].clientX; sl=el.scrollLeft; };
  el.ontouchmove = e=>{ el.scrollLeft=sl-(e.touches[0].clientX-sx); };
}

