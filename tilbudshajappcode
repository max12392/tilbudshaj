      <div class="admin-card">
        <div style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:var(--t);margin-bottom:4px">Live tilbud</div>
        <div style="font-size:12px;color:var(--m);margin-bottom:12px">
          ${storesInDb.length===0 ? "Ingen tilbud uploadet endnu — demo-tilbud vises." : state.adminSaved.length+" tilbud fra "+storesInDb.length+" butikker vises for alle kunder."}
        </div>
        ${storesInDb.map(s=>`
          <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--gl);border-radius:10px;border:1px solid #2a7d2e22;margin-bottom:8px">
            <div>
              <span style="font-weight:700;color:var(--t);font-size:14px">${escHtml(s)}</span>
              <span style="color:var(--m);font-size:12px;margin-left:8px">${state.adminSaved.filter(d=>d.store===s).length} tilbud</span>
            </div>
            <button class="del-store-btn" data-store="${escHtml(s)}" style="background:none;border:1px solid var(--b);color:var(--m);padding:4px 10px;border-radius:7px;font-size:11px;cursor:pointer">Slet</button>
          </div>`).join("")}
      </div>

      ${state.adminLog.length>0 ? `
        <div class="admin-card">
          <div style="font-family:'Playfair Display',serif;font-size:15px;font-weight:700;color:var(--t);margin-bottom:10px">Log</div>
          ${state.adminLog.map(l=>`<div style="font-size:12px;padding:6px 10px;border-radius:7px;background:${l.type==="error"?"#fdecea":l.type==="ok"?"var(--gl)":"#f5f5f5"};color:${l.type==="error"?"var(--r)":l.type==="ok"?"var(--g)":"var(--m)"};margin-bottom:5px">${escHtml(l.msg)}</div>`).join("")}
        </div>` : ""}
    </div>
  </div>`;
}

function addLog(msg, type="info") {
  state.adminLog = [{msg,type},...state.adminLog].slice(0,15);
}

function stampDeals(items, store) {
  return items.map((d,i)=>({
    id:`${store}-${Date.now()}-${i}`,
    store, name:d.name||"Ukendt", desc:d.desc||"",
    price:Number(d.price)||0, origPrice:d.origPrice?Number(d.origPrice):null,
    unit:d.unit||"", unitPrice:d.unitPrice||"", savings:Number(d.savings)||0,
    cat:d.cat||"Andet", emoji:d.emoji||"🛒", qty:1,
  }));
}

async function adminSaveDeals(newDeals) {
  const meta = {week_num:getWeek(), next_week:getWeek()+1, date_str:dkDate()};
  const ok = await SB.upsertDeals(newDeals, state.adminStore);
  await SB.upsertMeta(meta);
  const all = await SB.getDeals();
  if (all && all.length>0) {
    state.adminSaved = all;
    state.deals = all;
    state.meta = meta;
  }
  return ok;
}

async function doAdminFile() {
  if (!state.adminFiles.length) { addLog("Vælg en fil.","error"); render(); return; }
  if (!state.adminStore) { addLog("Vælg butik.","error"); render(); return; }
  state.adminLoading=true; render();
  let allNew=[];
  for (const file of state.adminFiles) {
    addLog(`Analyserer ${file.name}...`); render();
    try {
      const b64 = await new Promise((res,rej)=>{
        const r=new FileReader(); r.onload=()=>res(r.result.split(",")[1]); r.onerror=rej; r.readAsDataURL(file);
      });
      const isPdf = file.type==="application/pdf";
      const text = await callAI([{role:"user",content:[
        {type:isPdf?"document":"image", source:{type:"base64",media_type:file.type,data:b64}},
        {type:"text",text:AI_PROMPT(state.adminStore)}
      ]}]);
      const items = stampDeals(extractJSON(text), state.adminStore);
      allNew = [...allNew,...items];
      addLog(`✓ ${items.length} tilbud fundet i ${file.name}`, "ok");
    } catch(e) { addLog(`Fejl: ${e.message}`, "error"); }
  }
  if (allNew.length) {
    await adminSaveDeals(allNew);
    addLog(`💾 ${allNew.length} tilbud fra ${state.adminStore} er LIVE for alle kunder!`, "ok");
  }
  state.adminFiles=[]; state.adminLoading=false; render();
}

async function doAdminUrl() {
  if (!state.adminUrl.trim()) { addLog("Indsæt et link.","error"); render(); return; }
  if (!state.adminStore) { addLog("Vælg butik.","error"); render(); return; }
  state.adminLoading=true; addLog(`Søger tilbud fra ${state.adminStore}...`); render();
  try {
    const body = {
      model:"claude-sonnet-4-20250514", max_tokens:1000,
      tools:[{type:"web_search_20250305",name:"web_search"}],
      messages:[{role:"user",content:`Find alle aktuelle tilbud fra "${state.adminStore}" på: ${state.adminUrl.trim()}\n\n${AI_PROMPT(state.adminStore)}`}]
    };
    const r = await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    if (!r.ok) throw new Error(`API fejl ${r.status}`);
    const d = await r.json();
    const text = (d.content||[]).filter(b=>b.type==="text").map(b=>b.text).join("\n");
    if (!text.trim()) throw new Error("Ingen tekst fra AI — prøv billede-upload i stedet");
    const items = stampDeals(extractJSON(text), state.adminStore);
    await adminSaveDeals(items);
    addLog(`✓ ${items.length} tilbud fra ${state.adminStore} er LIVE!`, "ok");
    state.adminUrl="";
  } catch(e) { addLog(`Fejl: ${e.message}`, "error"); }
  state.adminLoading=false; render();
}

function bindAdmin() {
  const logout = document.getElementById("adminLogout");
  if (logout) logout.onclick = ()=>{ sessionStorage.removeItem("th_admin"); state.page="customer"; render(); };

  const storeSelect = document.getElementById("adminStore");
  if (storeSelect) storeSelect.onchange = e=>{ state.adminStore=e.target.value; render(); };

  const modeFile = document.getElementById("modeFile");
  if (modeFile) modeFile.onclick = ()=>{ state.adminMode="file"; render(); };

  const modeUrl = document.getElementById("modeUrl");
  if (modeUrl) modeUrl.onclick = ()=>{ state.adminMode="url"; render(); };

  const fileDrop = document.getElementById("fileDrop");
  const fileInput = document.getElementById("fileInput");
  if (fileDrop && fileInput) {
    fileDrop.onclick = ()=>fileInput.click();
    fileInput.onchange = e=>{ state.adminFiles=Array.from(e.target.files); render(); };
  }

  const urlInput = document.getElementById("urlInput");
  if (urlInput) urlInput.oninput = e=>{ state.adminUrl=e.target.value; };

  const analyse = document.getElementById("adminAnalyse");
  if (analyse) analyse.onclick = ()=>{
    if (!state.adminLoading) {
      state.adminMode==="url" ? doAdminUrl() : doAdminFile();
    }
  };

  document.querySelectorAll(".del-store-btn").forEach(btn=>{
    btn.onclick = async ()=>{
      await SB.deleteStore(btn.dataset.store);
      const all = await SB.getDeals();
      state.adminSaved = all||[];
      state.deals = all && all.length>0 ? all : DEMO;
      addLog(`${btn.dataset.store} slettet.`);
      render();
    };
  });
}

// ════════════════════════════════════════════════════════════════
// UTILS
// ════════════════════════════════════════════════════════════════
function escHtml(s) {
  if (!s) return "";
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

// ════════════════════════════════════════════════════════════════
// INIT
// ════════════════════════════════════════════════════════════════
async function init() {
  state.loading = true;
  render();

  // Hent fra Supabase
  try {
    const [deals, meta] = await Promise.all([SB.getDeals(), SB.getMeta()]);
    state.deals = (deals && deals.length>0) ? deals : DEMO;
    state.meta = meta;
    state.adminSaved = (deals && deals.length>0) ? deals : [];
  } catch {
    state.deals = DEMO;
  }

  state.loading = false;
  render();
}

init();
</script>
</body>
