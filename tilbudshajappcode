    <div style="max-width:660px;margin:0 auto;padding:20px 14px 60px">

      <div class="admin-card">
        <div style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:var(--t);margin-bottom:3px">Upload tilbudsavis</div>
        <div style="font-size:12px;color:var(--m);margin-bottom:16px">AI analyserer og opdaterer alle kunders app automatisk.</div>

        <label style="font-size:12px;font-weight:700;color:var(--s);display:block;margin-bottom:6px">Butik</label>
        <select id="adminStore" style="width:100%;padding:10px 12px;border:1.5px solid ${state.adminStore?"var(--g)":"var(--b)"};border-radius:10px;font-size:16px;color:${state.adminStore?"var(--t)":"var(--m)"};background:#fff;outline:none;cursor:pointer;margin-bottom:14px">
          <option value="">Vælg butik...</option>
          ${STORE_LIST.map(s=>`<option value="${s}" ${state.adminStore===s?"selected":""}>${s}</option>`).join("")}
        </select>

        <div style="display:flex;border-radius:10px;overflow:hidden;border:1.5px solid var(--b);margin-bottom:14px">
          <button id="modeFile" style="flex:1;padding:9px 0;border:none;background:${state.adminMode==="file"?"var(--g)":"#fff"};color:${state.adminMode==="file"?"#fff":"var(--m)"};font-weight:700;font-size:13px;cursor:pointer">📄 Upload fil</button>
          <button id="modeUrl" style="flex:1;padding:9px 0;border:none;background:${state.adminMode==="url"?"var(--g)":"#fff"};color:${state.adminMode==="url"?"#fff":"var(--m)"};font-weight:700;font-size:13px;cursor:pointer">🔗 Indsæt link</button>
        </div>

        ${state.adminMode==="file" ? `
          <div id="fileDrop" style="border:2px dashed ${state.adminFiles.length?"var(--g)":"var(--b)"};border-radius:12px;padding:20px 16px;text-align:center;cursor:pointer;background:${state.adminFiles.length?"var(--gl)":"#fafafa"};margin-bottom:14px">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="${state.adminFiles.length?"var(--g)":"var(--m)"}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            ${state.adminFiles.length===0
              ? `<div style="font-size:13px;color:var(--m);margin-top:8px">Klik for at vælge PDF eller billede</div>`
              : `<div style="font-size:13px;color:var(--g);font-weight:600;margin-top:8px">✓ ${state.adminFiles.map(f=>f.name||f).join(", ")}</div>`}
            <input type="file" id="fileInput" accept=".pdf,image/*" multiple style="display:none"/>
          </div>` : `
          <div style="margin-bottom:14px">
            <input id="urlInput" value="${escHtml(state.adminUrl)}" placeholder="https://rema1000.dk/tilbud" style="width:100%;padding:11px 14px;border:1.5px solid ${state.adminUrl?"var(--g)":"var(--b)"};border-radius:10px;font-size:16px;outline:none;color:var(--t);background:#fff"/>
            <div style="font-size:11px;color:var(--m);margin-top:6px;line-height:1.5">💡 Find links på etilbudsavis.dk. Tip: Billede-upload er mere pålideligt.</div>
          </div>`}

        <button id="adminAnalyse" style="width:100%;padding:13px;background:${state.adminLoading?"var(--m)":"var(--g)"};color:#fff;border:none;border-radius:12px;font-family:'Playfair Display',serif;font-size:15px;font-weight:700;cursor:${state.adminLoading?"not-allowed":"pointer"};display:flex;align-items:center;justify-content:center;gap:10px">
          ${state.adminLoading ? `<span class="spinner"></span>Analyserer...` : state.adminMode==="url" ? "🔗 Hent og analysér" : "📄 Analysér og gem"}
